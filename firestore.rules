rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().role
        : null;
    }

    function isSuperAdmin() {
      return getUserRole() == 'Super Admin';
    }

    function isHRManager() {
      return getUserRole() == 'HR Manager';
    }

    function isStaffAdmin() {
      return isSuperAdmin() || isHRManager();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaffAdmin());
      allow create: if isSuperAdmin()
                    || (isAuthenticated() && request.auth.uid == userId && request.resource.data.role == 'Pending');
      allow update: if isSuperAdmin() && request.auth.uid != userId;
      allow delete: if isSuperAdmin() && request.auth.uid != userId;
    }

    match /employees/{docId} {
      allow read, write: if isStaffAdmin();
    }

    match /departments/{docId} {
      allow read, write: if isStaffAdmin();
    }

    match /positions/{docId} {
      allow read, write: if isStaffAdmin();
    }

    match /attendance/{docId} {
      allow read, write: if isStaffAdmin();
    }

    match /leaveRequests/{docId} {
      allow read, write: if isStaffAdmin();
    }

    match /performanceReviews/{docId} {
      allow read, write: if isStaffAdmin();
    }

    match /recruitment_jobs/{docId} {
      allow read, write: if isStaffAdmin();
    }

    match /recruitment_candidates/{docId} {
      allow read, write: if isStaffAdmin();
    }

    match /assets/{docId} {
      allow read, write: if isStaffAdmin();
    }

    match /announcements/{docId} {
      allow read, write: if isStaffAdmin();
    }

    match /notifications/{docId} {
      allow read, write: if isStaffAdmin();
    }

    match /settings/{docId} {
      allow read, write: if isStaffAdmin();
    }

    match /payroll/{docId} {
      allow read: if isStaffAdmin();
      allow write: if isSuperAdmin();
    }

    match /auditLogs/{docId} {
      allow read: if isStaffAdmin();
      allow create: if isStaffAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
