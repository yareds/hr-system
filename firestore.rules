rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().role
        : null;
    }

    function isSuperAdmin() {
      return getUserRole() == 'Super Admin';
    }

    function isHRManager() {
      return getUserRole() == 'HR Manager';
    }

    function isStaffAdmin() {
      return isSuperAdmin() || isHRManager();
    }

    // Users & Roles collection
    match /users/{userId} {
      // Users can read their own doc; Super Admins & HR Managers can read all user docs
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaffAdmin());
      // Super Admin can create other users' docs, or an authenticated user can create their initial doc
      allow create: if isAuthenticated() && (isSuperAdmin() || request.auth.uid == userId);
      // Super Admin can update user docs, or an authenticated user can update their own doc
      allow update: if isAuthenticated() && (isSuperAdmin() || request.auth.uid == userId);
      allow delete: if isSuperAdmin() && request.auth.uid != userId;
    }

    // Core HR collections (Authenticated users)
    match /employees/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /departments/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /positions/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /attendance/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /leaveRequests/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /performanceReviews/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /recruitment_jobs/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /recruitment_candidates/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /assets/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /announcements/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /notifications/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /settings/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /payroll/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /auditLogs/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
