          "type": "object",
          "properties": {
            "bankName": { "type": "string" },
            "accountNumber": { "type": "string" },
            "routingNumber": { "type": "string" }
          }
        },
        "taxInfo": {
          "type": "object",
          "properties": {
            "taxId": { "type": "string" },
            "filingStatus": { "type": "string" },
            "allowances": { "type": "number" }
          }
        },
        "workSchedule": { "type": "string" },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "type": { "type": "string" },
              "url": { "type": "string" },
              "uploadedAt": { "type": "string" }
            }
          }
        },
        "leaveBalance": {
          "type": "object",
          "properties": {
            "annual": { "type": "number" },
            "sick": { "type": "number" },
            "personal": { "type": "number" },
            "maternity": { "type": "number" },
            "paternity": { "type": "number" },
            "bereavement": { "type": "number" }
          }
        },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["employeeId", "firstName", "lastName", "email", "department", "position", "employmentStatus"]
