        "currency": { "type": "string" },
        "fiscalYearStart": { "type": "string" },
        "payFrequency": { "type": "string" },
        "standardWorkHours": { "type": "number" },
        "overtimeMultiplier": { "type": "number" },
        "maternityLeaveDays": { "type": "number" },
        "paternityLeaveDays": { "type": "number" },
        "annualLeaveDays": { "type": "number" },
        "sickLeaveDays": { "type": "number" },
        "address": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" }
      }
