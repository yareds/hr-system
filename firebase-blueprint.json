        "notes": { "type": "string" }
      },
      "required": ["employeeId", "date", "status"]
    },
    "leaveRequests": {
      "title": "Leave Request Record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "department": { "type": "string" },
        "leaveType": { "type": "string", "enum": ["Annual", "Sick", "Personal", "Maternity", "Paternity", "Bereavement", "Unpaid"] },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "totalDays": { "type": "number" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected", "Cancelled"] },
