{
  "entities": {
    "users": {
      "title": "User Account & Role Profile",
      "description": "User accounts with assigned system roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["Super Admin", "HR Manager", "Payroll Officer", "Department Manager", "Employee"] },
        "employeeId": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "employees": {
      "title": "Employee Profile",
      "description": "Comprehensive employee profile record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "gender": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "photoUrl": { "type": "string" },
        "address": { "type": "string" },
        "emergencyContact": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "relationship": { "type": "string" },
            "phone": { "type": "string" }
          }
        },
        "department": { "type": "string" },
        "position": { "type": "string" },
        "managerId": { "type": "string" },
        "managerName": { "type": "string" },
        "employmentType": { "type": "string", "enum": ["Full-Time", "Part-Time", "Contract", "Intern"] },
        "hireDate": { "type": "string" },
        "employmentStatus": { "type": "string", "enum": ["Active", "On Leave", "Archived", "Terminated"] },
        "salary": { "type": "number" },
        "payType": { "type": "string", "enum": ["Salary", "Hourly"] },
        "hourlyRate": { "type": "number" },
        "payFrequency": { "type": "string", "enum": ["Monthly", "Biweekly", "Weekly"] },
        "costCenter": { "type": "string" },
        "location": { "type": "string" },
